# NOTE: DATABASE_URL is intentionally NOT set here.
# It's provided by .env.local (gitignored) — which can point to either
# SQLite (sandbox) or Neon Postgres (production test). For production deploy,
# set DATABASE_URL + DATABASE_URL_UNPOOLED in the Vercel/Render dashboards.
SESSION_SECRET=10x-rpc-sandbox-session-secret-change-me-32bytes-min
NEXT_PUBLIC_APP_URL=http://localhost:3000
